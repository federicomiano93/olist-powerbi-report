			column 'Fiscal Year'
				isHidden
				formatString: 0
				lineageTag: 73ca5d3f-150e-432e-9c12-4e3bff77ca3f
				summarizeBy: sum
				isNameInferred
				sourceColumn: [Fiscal Year]

				annotation SummarizationSetBy = Automatic

			partition calendar = calculated
				mode: import
				source = ```
						
						VAR MinDate = MIN(fact_orders[order_purchase_timestamp])
						VAR MaxDate = MAX(fact_orders[order_purchase_timestamp])
						VAR StartYear = YEAR(MinDate)
						VAR EndYear = YEAR(MaxDate)
						
						RETURN
						SELECTCOLUMNS (
						    CALENDAR ( DATE ( StartYear, 1, 1 ), DATE ( EndYear, 12, 31 ) ),
						    "Date", [Date], 
						    "Month Number", MONTH ( [Date] ),
						    "Month Name", FORMAT ( [Date], "MMMM" ),
						    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
						    "Year", YEAR ( [Date] ),
						
						    "Fiscal Month Number", 
						        IF ( MONTH ( [Date] ) >= 7, MONTH ( [Date] ) - 6, MONTH ( [Date] ) + 6 ),
						
						    "Fiscal Month Name", 
						        FORMAT ( [Date], "MMMM" ),
						
						    "Fiscal Quarter", 
						        "Q" & CEILING ( IF ( MONTH ( [Date] ) >= 7, MONTH ( [Date] ) - 6, MONTH ( [Date] ) + 6 ) / 3, 1 ),
						
						    "Fiscal Year", 
						        IF ( MONTH ( [Date] ) >= 7, YEAR ( [Date] ) + 1, YEAR ( [Date] ) )
						)
						```

			annotation PBI_Id = 05e083cd1993428ca574a2d3b3451b44

		table misure
			lineageTag: 0e12da68-5f05-4b06-9943-412513e65b6f

			measure 'Orders Count' = DISTINCTCOUNT(fact_orders[order_id])
				formatString: 0.00
				displayFolder: Orders
				lineageTag: 47bb089e-dd51-4bd1-a743-ea77b2d6b9b4

			measure 'Orders Count PY' =
					
					CALCULATE(
					    [Orders Count],
					    PARALLELPERIOD('calendar'[Date], -12, MONTH)
					)
				formatString: 0
				displayFolder: Orders
				lineageTag: 8ad7537a-85e7-4348-963f-f5f73636c6ca

			measure 'Orders Count YoY %' =
					
					DIVIDE(
					    [Orders Count] - [Orders Count PY],
					    [Orders Count PY]
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Orders
				lineageTag: 8d94f80b-53f2-467f-852c-07d1efd51b4f

			measure 'Total Revenue' =
					
					SUMX(fact_orders, fact_orders[Revenue]
					)
				formatString: #,0.00
				displayFolder: Revenue
				lineageTag: 91983080-00a1-4ec7-ba1d-cb1c4c6291b6

			measure 'Total Revenue PY' =
					
					CALCULATE(
					    [Total Revenue],
					    PARALLELPERIOD('calendar'[Date], -12, MONTH)
					    )
				formatString: #,0.00
				displayFolder: Revenue
				lineageTag: f05f9648-fcbe-4a4c-8ccd-9c86e0dfc1fe

			measure 'Total Revenue YoY %' =
					
					DIVIDE(
					    [Total Revenue] - [Total Revenue PY],
					    [Total Revenue PY]
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Revenue
				lineageTag: 2a47cff9-3757-4893-8149-3bff14d2cbb6

			measure 'Reviews Count' = COUNTROWS(fact_order_reviews)
				formatString: 0
				displayFolder: Reviews
				lineageTag: 341cfa21-f429-4216-8dd6-e8188e0128b0

			measure 'Orders Count Jan-Aug' =
					
					CALCULATE([Orders Count], 'calendar'[Month Number] <= 8)
				formatString: 0.00
				displayFolder: Orders/KPI Cards
				lineageTag: 1dc95e65-4c84-453a-b5a4-aa6dd52699d2

			measure 'Orders Count PY Jan-Aug' =
					
					CALCULATE([Orders Count PY], 'calendar'[Month Number] <= 8)
				formatString: 0.00
				displayFolder: Orders/KPI Cards
				lineageTag: 4eb300ab-0f1f-49e7-9584-0c20c747ec08

			measure 'Orders YoY % Jan-Aug' =
					
					DIVIDE(
					    [Orders Count Jan-Aug] - [Orders Count PY Jan-Aug],
					    [Orders Count PY Jan-Aug]
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Orders/KPI Cards
				lineageTag: 95642a5f-fcb5-406c-a5ca-68606dee3f66

			measure 'Total Revenue Jan-Aug' =
					
					CALCULATE([Total Revenue], 'calendar'[Month Number] <= 8)
				formatString: #,0.00
				displayFolder: Revenue/KPI Cards
				lineageTag: 8cdbf4c1-fbd6-47ca-9658-6c767429c684

			measure 'Total revenue PY Jan-Aug' =
					
					CALCULATE([Total Revenue PY], 'calendar'[Month Number] <= 8)
				formatString: #,0.00
				displayFolder: Revenue/KPI Cards
				lineageTag: d4da79af-f6be-4d46-8a1e-63929e68caba

			measure 'Revenue YoY % Jan-Aug' =
					
					DIVIDE(
					    [Total Revenue Jan-Aug] - [Total revenue PY Jan-Aug],
					    [Total revenue PY Jan-Aug]
					)
				formatString: 0.00%;-0.00%;0.00%
				displayFolder: Revenue/KPI Cards
				lineageTag: 0307e4ac-a34b-4c2b-9259-1af5557b8d0c

